/*
  Cache headers for static hosts (Netlify, Cloudflare Pages and others that
  read the _headers file). Long-lived caching for the generated volume data
  and the extracted artwork, revalidated HTML for everything else.
*/

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/reader.html
  Cache-Control: public, max-age=0, must-revalidate

/data.js
  Cache-Control: public, max-age=3600, must-revalidate

/volumes/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/images/*
  Cache-Control: public, max-age=2592000, immutable

/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate
